{
  "info": {
    "name": "IPTV API",
    "description": "Проверки локального API на исходных demo-данных. Запустите сервис по README и используйте Send или Run collection. Запросы не меняют данные. После ручных изменений каналов и подписок ожидаемые статусы могут отличаться. Значения username/password публичные и предназначены для локальной проверки.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{username}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{password}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8080",
      "type": "string"
    },
    {
      "key": "username",
      "value": "viewer",
      "type": "string"
    },
    {
      "key": "password",
      "value": "viewer_demo",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test(\"Content-Type: application/json\", function () {",
          "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.eql(\"application/json\");",
          "});",
          "if (pm.response.code >= 400 && pm.request.method !== \"HEAD\") {",
          "    pm.test(\"Единый JSON ошибки без дополнительных полей\", function () {",
          "        const body = pm.response.json();",
          "        pm.expect(body).to.have.all.keys(\"error\");",
          "        pm.expect(body.error).to.have.all.keys(\"code\", \"message\");",
          "        pm.expect(body.error.code).to.be.a(\"string\");",
          "        pm.expect(body.error.message).to.be.a(\"string\");",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Список каналов — 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/channels"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Каталог содержит каналы без URL потоков\", function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.channels).to.be.an(\"array\");",
              "    body.channels.forEach(function (channel) {",
              "        pm.expect(channel).to.have.all.keys(\"id\", \"number\", \"name\");",
              "        pm.expect(channel.id).to.be.a(\"number\").and.above(0);",
              "        pm.expect(channel.number).to.be.a(\"number\").and.above(0);",
              "        pm.expect(channel.name).to.be.a(\"string\");",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Просмотр канала 1 — 200",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/channels/1/playback"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"Ответ содержит HLS URL demo-канала\", function () {",
              "    pm.expect(pm.response.json()).to.eql({",
              "        channel_id: 1,",
              "        url: \"https://stream.example.com/live/ch1/index.m3u8\"",
              "    });",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "HEAD просмотра — 200 без тела",
      "request": {
        "method": "HEAD",
        "header": [],
        "url": "{{base_url}}/api/v1/channels/1/playback"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test(\"HEAD не возвращает тело\", function () {",
              "    pm.expect(pm.response.text()).to.eql(\"\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Без Basic Auth — 401",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{base_url}}/api/v1/channels",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", function () {",
              "    pm.response.to.have.status(401);",
              "});",
              "pm.test(\"error.code = unauthorized\", function () {",
              "    pm.expect(pm.response.json().error.code).to.eql(\"unauthorized\");",
              "});",
              "pm.test(\"Basic Auth challenge\", function () {",
              "    pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.eql('Basic realm=\"iptv\"');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Неверный пароль — 401",
      "request": {
