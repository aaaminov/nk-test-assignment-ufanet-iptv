# Public example values for the local demo database and application.
POSTGRES_USER=iptv_demo
POSTGRES_PASSWORD=iptv_demo
POSTGRES_DB=iptv_demo
DATABASE_URL='postgres://iptv_demo:iptv_demo@db:5432/iptv_demo?sslmode=disable'
HTTP_PORT=8080
DB_MAX_CONNS=10
LOG_LEVEL=info

# Separate disposable integration database.
TEST_POSTGRES_USER=iptv_test
TEST_POSTGRES_PASSWORD=iptv_test
TEST_POSTGRES_DB=iptv_test
TEST_POSTGRES_PORT=15432
TEST_DATABASE_URL='postgres://iptv_test:iptv_test@127.0.0.1:15432/iptv_test?sslmode=disable'
